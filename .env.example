# Variable catalog for the future implementation; no credentials are supplied.
# Web: .env.local (omit all worker-only and spike-only values).
# Worker: .env.worker.local (include shared DB/network/public addresses/receipt key).
# Optional headless Testnet harness: .env.spike.local; never loaded by web/normal worker.
# `pnpm setup:spike` creates separate disposable local signers without printing them.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Local DB setup generates this ignored file automatically: .env.integration.local.
# Local Docker only; db:setup selects an unused loopback port and dedicated project.
AEGISPAY_POSTGRES_PROJECT=
AEGISPAY_POSTGRES_PASSWORD=
AEGISPAY_POSTGRES_PORT=
# Must be the distinct aegispay_integration database, never a live/spike ledger.
TEST_DATABASE_URL=

# Verify from organizer instructions and the live ledger, not SDK defaults.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=
NOIR_DEVICE_REGISTRY_ID=
NOIR_AGENT_REGISTRY_ID=
NOIR_PAYMENT_ESCROW_ID=
NOIR_XLM_SAC_ID=
DEMO_OWNER_PUBLIC_KEY=
DEMO_AGENT_PUBLIC_KEY=
DEMO_MERCHANT_PUBLIC_KEY=
# Lowercase 32-byte device hash for configured demo catalog seed (not policy proof).
DEMO_DEVICE_HASH=

# Worker-only. Use disposable capped Testnet agent credentials.
AGENT_SECRET=
VELO_GAS_API_KEY=
# Use a Gas Station Testnet key (tg_test_...), with a funded/allowlisted/enabled project relayer.
VELO_GAS_BASE_URL=https://www.velo-build.dev
GEMINI_API_KEY=
AGENT_MODEL=
# Base64 of a random 32-byte AES key, never committed.
ENVELOPE_ENCRYPTION_KEY=

# Web-only login secrets; independently generated high-entropy opaque values.
DEMO_OWNER_LOGIN_TOKEN=
DEMO_MERCHANT_LOGIN_TOKEN=
# Shared web/worker receipt HMAC key; independently generated secret.
RECEIPT_SIGNING_KEY=

# Opt-in live test guard. Mainnet is always refused.
RUN_TESTNET=0

# Optional spike-only disposable Testnet signers; normal app uses Freighter.
SPIKE_OWNER_SECRET=
SPIKE_MERCHANT_SECRET=
