{
  "name": "aegispay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": "24.22.1" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts src tests --no-error-on-unmatched-pattern",
    "verify:sdk-imports": "tsx scripts/sdk-imports.ts",
    "verify:contracts": "node --env-file-if-exists=.env.spike.local --import tsx scripts/verify-contracts.ts",
    "setup:spike": "tsx scripts/setup-spike.ts",
    "setup:noir-fixture": "node --env-file-if-exists=.env.spike.local --import tsx scripts/spike-noir-velo.ts --setup",
    "test:spike": "node --import tsx --test tests/testnet/config.test.ts tests/testnet/contracts.test.ts tests/testnet/guards.test.ts tests/testnet/evidence.test.ts tests/testnet/handoff.test.ts tests/testnet/journal.test.ts tests/testnet/setup.test.ts tests/testnet/driver.test.ts",
    "spike:noir-velo": "node --env-file-if-exists=.env.spike.local --import tsx scripts/spike-noir-velo.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:testnet": "node --env-file-if-exists=.env.spike.local --import tsx --test tests/testnet/*.test.ts",
    "build": "next build",
    "demo:smoke": "tsx scripts/demo-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@carts1024/velo-sdk": "1.0.0",
    "@noirx402/agent-sdk": "0.3.0",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "16.4.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
