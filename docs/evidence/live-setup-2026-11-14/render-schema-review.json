            "accelerated_256gb",
            "accelerated_384gb",
            "accelerated_512gb",
            "accelerated_768gb",
            "accelerated_1024gb",
            "0.1c-256mb",
            "0.5c-1g",
            "1c-2g",
            "1c-4g",
            "2c-4g",
            "2c-8g",
            "2c-16g",
            "4c-16g",
            "4c-32g",
            "8c-32g",
